{
  "manifest_version": 3,
  "name": "b1api Browser Controls",
  "version": "1.0.0",
  "description": "Browser-level per-site controls for b1api.",
  "permissions": ["activeTab", "tabs", "storage", "contentSettings"],
  "action": {"default_title": "b1api Browser Controls", "default_popup": "popup.html"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "background": {"service_worker": "service-worker.js"}
}
